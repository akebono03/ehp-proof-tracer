def _run_execute_command(
  generator_input: str,
  candidate_number: int | None = None,
) -> int:
  try:
    result = (
      run_standard_repository_generator_user_execution_workflow(
        generator_input,
        candidate_number=candidate_number,
      )
    )
  except (
    TypeError,
    ValueError,
  ) as error:
    parser = (
      build_execute_argument_parser()
    )
    parser.error(
      str(
        error
      )
    )

  if (
    result.status
    is RepositoryGeneratorUserExecutionWorkflowStatus.NONE
  ):
    print(
      "No executable target found for "
      f"{generator_input}."
    )
    return 1

  if (
    result.status
    is RepositoryGeneratorUserExecutionWorkflowStatus.AMBIGUOUS
  ):
    known_group_presentation = (
      build_standard_repository_generator_known_group_identity_presentation_input(
        generator_input
      )
    )

    known_group_markdown = (
      render_repository_generator_known_group_identity_markdown(
        known_group_presentation
      )
    )

    candidate_presentation = (
      build_repository_generator_user_execution_candidate_list_presentation(
        result
      )
    )

    candidate_markdown = (
      render_repository_generator_user_execution_candidate_list_markdown(
        candidate_presentation
      )
    )

    print(
      known_group_markdown
      + "\n"
      + candidate_markdown,
      end="",
    )

    return 0

  if (
    result.status
    is RepositoryGeneratorUserExecutionWorkflowStatus.EXECUTED
  ):
    if result.markdown is None:
      raise RuntimeError(
        "executed workflow result must contain markdown"
      )

    print(
      result.markdown,
      end="",
    )

    return 0

  raise RuntimeError(
    "unsupported user execution workflow status"
  )


def main(
  argv: Sequence[str] | None = None,
) -> int:
  raw_argv = (
    list(
      argv
    )
    if argv is not None
    else sys.argv[
      1:
    ]
  )

  if (
    raw_argv
    and raw_argv[
      0
    ] == "explore"
  ):
    parser = (
      build_explore_argument_parser()
    )

    args = parser.parse_args(
      raw_argv[
        1:
      ]
    )

    return _run_explore_command(
      args.generator
    )

  if (
    raw_argv
    and raw_argv[
      0
    ] == "explore-proof"
  ):
    parser = (
      build_explore_proof_argument_parser()
    )

    args = parser.parse_args(
      raw_argv[
        1:
      ]
    )

    return _run_explore_proof_command(
      args.generator
    )

  if (
    raw_argv
    and raw_argv[
      0
    ] == "explore-applicable"
  ):
    parser = (
      build_explore_applicable_argument_parser()
    )

    args = parser.parse_args(
      raw_argv[
        1:
      ]
    )

    return _run_explore_applicable_command(
      args.generator,
      detailed=args.detailed,
    )

  if (
    raw_argv
    and raw_argv[
      0
    ] == "show-proof"
  ):
    parser = (
      build_show_proof_argument_parser()
    )

    args = parser.parse_args(
      raw_argv[
        1:
      ]
    )

    return _run_show_proof_command(
      args.generator
    )

  if (
    raw_argv
    and raw_argv[
      0
    ] == "execute"
  ):
    parser = (
      build_execute_argument_parser()
    )

    args = parser.parse_args(
      raw_argv[
        1:
      ]
    )

    return _run_execute_command(
      args.generator,
      candidate_number=args.candidate,
    )

  parser = build_argument_parser()

  args = parser.parse_args(
    raw_argv
  )

  result = (
    build_standard_toda_report(
      n=args.n,
      k=args.k,
    )
  )

  if (
    result.status
    is TodaCalculationStatus.NOT_FOUND
  ):
    print(
      "No proof report found for "
      f"pi_{{{args.n + args.k}}}^{{{args.n}}}."
    )
    return 1

  print(
    "\n\n---\n\n".join(
      result.reports
    )
  )

  return 0


if __name__ == "__main__":
  _configure_cli_utf8_streams()

  raise SystemExit(
    main()
  )
