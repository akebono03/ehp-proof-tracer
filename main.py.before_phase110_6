def _run_explore_command(
  generator_input: str,
) -> int:
  try:
    report = (
      explore_standard_repository_generator_input(
        generator_input
      )
    )
  except (
    TypeError,
    ValueError,
  ) as error:
    parser = (
      build_explore_argument_parser()
    )
    parser.error(
      str(
        error
      )
    )

  print(
    report.markdown,
    end="",
  )

  return 0


