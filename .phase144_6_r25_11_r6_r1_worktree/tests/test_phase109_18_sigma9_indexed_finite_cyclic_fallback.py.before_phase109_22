def test_phase109_18_decorated_sigma_fallback_still_works():
  for generator, expected_group in (
    (
      GeneratorSymbol(
        family="σ",
        decoration="'''",
      ),
      TodaPrimaryGroup(
        group_dimension=12,
        sphere_dimension=5,
      ),
    ),
    (
      GeneratorSymbol(
        family="σ",
        decoration="''",
      ),
      TodaPrimaryGroup(
        group_dimension=13,
        sphere_dimension=6,
      ),
    ),
    (
      GeneratorSymbol(
        family="σ",
        decoration="'",
      ),
      TodaPrimaryGroup(
        group_dimension=14,
        sphere_dimension=7,
      ),
    ),
  ):
    nodes = (
      find_standard_repository_generator_known_group_identity_nodes(
        generator
      )
    )

    assert len(
      nodes
    ) == 1

    assert (
      nodes[
        0
      ].proof_step.conclusion.lhs
      == expected_group
    )


