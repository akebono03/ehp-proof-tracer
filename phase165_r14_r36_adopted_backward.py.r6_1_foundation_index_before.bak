"""R36: goal-driven rebuilding using explicit adopted-TeX and foundational leaves.

No strict registry claim is promoted; no R33 completed ProofStep is replayed.
"""
from __future__ import annotations

from pathlib import Path

from phase165_r14_r17_foundational_proofstep import derive_foundational_suspension_step
from phase165_r14_r21_toda51_completion import complete_toda51_source
from phase165_r14_r22_same_reference import integrate_toda51_into_existing_reference
from phase165_r14_r23_toda51_inference import AdoptedTextReview, promote_diagonal_from_existing_reference
from phase165_r14_r34_backward_search import phase165_r34_expansions, pi32_goal
from phase165_r14_r35_leaf_binding import backward_leaf_goals, known_source_candidates
from phase165_r5_manifest_bridge import build_phase165_r5_manifest_bridge
from phase164_r8_proofstep_factory import derive_inference_proof_step
from proof import ProofRule, ProofStep, find_inference_matches_for_rule


def adopted_leaf_steps(tex_path: Path) -> tuple[ProofStep, ...]:
    """Register cited source steps independently of a selected proof goal.

    The adopted source bundle has two reviewed diagonal statements,
    six explicitly typed source statements, and the foundational identity
    E(iota_2)=iota_3. This inventory is not derived from a search frontier.
    """
    from phase165_r14_r16_foundational_suspension import (
        instantiate_foundational_identity_suspension,
    )
    path = Path(tex_path)
    candidates = known_source_candidates(path)
    source_text = path.read_text(encoding="utf-8")
    completed = complete_toda51_source(source_text)
    bridge, _ = build_phase165_r5_manifest_bridge()
    integration = integrate_toda51_into_existing_reference(bridge, source_text)
    review = AdoptedTextReview(
        complete_source_sha256=completed.source_sha256,
        diagonal_clause_checked=True,
        reviewer_note="Adopted TeX (5.1) diagonal clause reviewed; original edition unverified",
    )
    reviewed, ids = promote_diagonal_from_existing_reference(integration.bridge, review)
    diagonal_steps = []
    for assertion_id in ids:
        matches = [link.step for link in reviewed.proof_links
                   if link.assertion_id == assertion_id and link.step is not None]
        if len(matches) != 1:
            raise ValueError("ambiguous adopted diagonal source link")
        if matches[0].conclusion != reviewed.registry.assertion(assertion_id).content:
            raise ValueError("diagonal source linkage mismatch")
        diagonal_steps.append(matches[0])
    if len(diagonal_steps) != 2:
        raise ValueError("adopted diagonal source inventory changed")

    for candidate in candidates:
        if candidate.certification != "unverified_source_claim":
            raise ValueError("unexpected source candidate certification")
    if len(candidates) != 6:
        raise ValueError("adopted source candidate inventory changed")

    foundation_goal = instantiate_foundational_identity_suspension(2).statement
    foundation = derive_foundational_suspension_step(foundation_goal)
    if foundation is None or foundation.rule is not ProofRule.GIVEN:
        raise ValueError("foundational suspension source unavailable")

    from phase165_r14_r33_final_group import pi33_cyclic_step, hopf_eta2_image_step
    from phase165_r14_r31_hopf_injective import toda51_pi21_zero_step, prop42_e_h_exactness_step
    from phase165_r14_r30_hopf_surjective import prop42_h_delta_exactness_step
    from phase165_r14_r26_prop42_typed import adopted_tex_proofstep, bind_proposition42
    from phase165_r14_r29_delta_derived import Prop42ApplicationPolicy

    policy = Prop42ApplicationPolicy(use_unrestricted_statement_as_written=True)
    step_list = [*diagonal_steps, foundation,
                 pi33_cyclic_step(path), hopf_eta2_image_step(),
                 toda51_pi21_zero_step(path),
                 prop42_e_h_exactness_step(policy),
                 prop42_h_delta_exactness_step(policy),
                 adopted_tex_proofstep(bind_proposition42(
                     bridge, n=1, i=2, index_scope_confirmed=True,
                 ))]
    if len(step_list) != 9:
        raise ValueError("adopted source inventory changed")
    for step in step_list:
        if not isinstance(step, ProofStep) or step.rule is not ProofRule.GIVEN:
            raise ValueError("adopted source leaf must be a GIVEN ProofStep")
        if sum(other.conclusion == step.conclusion for other in step_list) != 1:
            raise ValueError("duplicate adopted source conclusion")
    if {candidate.goal for candidate in candidates} - {step.conclusion for step in step_list}:
        raise ValueError("source candidates are not represented by typed steps")
    return tuple(step_list)



def reconstruct_adopted_tex_goal(
    goal: object, leaf_steps: tuple[ProofStep, ...], *, limit: int = 80,
) -> ProofStep:
    """Build only from goal expansions and exact typed leaf lookup, no proof replay."""
    if type(limit) is not int or limit <= 0:
        raise ValueError("positive goal limit required")
    visited: list[object] = []
    active: list[object] = []
    memo: list[tuple[object, ProofStep]] = []

    def visit(current: object) -> ProofStep:
        found = [step for key, step in memo if key == current]
        if found:
            return found[0]
        if any(key == current for key in active):
            raise ValueError("cyclic derivation")
        if len(visited) >= limit:
            raise ValueError("search limit exceeded")
        visited.append(current)
        active.append(current)
        try:
            options = phase165_r34_expansions(current)
            if len(options) > 1:
                raise ValueError("ambiguous inference expansion")
            if options:
                expansion = options[0]
                premises = tuple(visit(child) for child in expansion.subgoals)
                matches = find_inference_matches_for_rule(expansion.rule, premises)
                if len(matches) != 1:
                    raise ValueError(f"inference match failed for {current!r}")
                step = derive_inference_proof_step(matches[0])
                if step.conclusion != current or step.rule is not ProofRule.INFERENCE:
                    raise ValueError("inference result changed")
            else:
                matched = [leaf for leaf in leaf_steps if leaf.conclusion == current]
                if len(matched) != 1 or matched[0].rule is not ProofRule.GIVEN:
                    raise ValueError(f"unresolved or ambiguous adopted leaf: {current!r}")
                step = matched[0]
            memo.append((current, step))
            return step
        finally:
            active.pop()

    return visit(goal)


def audit_r36(tex_path: Path) -> dict:
    leaves = adopted_leaf_steps(tex_path)
    proof = reconstruct_adopted_tex_goal(pi32_goal(), leaves)
    if proof.conclusion != pi32_goal():
        raise ValueError("wrong final goal")
    return {
        "phase": "165 R14-R36",
        "frontier_leaf_count": len(backward_leaf_goals(pi32_goal())),
        "adopted_tex_leaf_count": sum(not bool(getattr(s, "foundational_reference", None)) for s in leaves),
        "foundational_leaf_count": sum(bool(getattr(s, "foundational_reference", None)) for s in leaves),
        "all_leaf_goals_resolved_for_adopted_search": True,
        "goal": repr(proof.conclusion),
        "adopted_backward_proof_created": True,
        "existing_completed_proof_replay_used": False,
        "registry_assertions_promoted_to_strict": 0,
        "strict_registry_proof_created": False,
        "status": "ADOPTED_TEX_BACKWARD_DERIVED_STRICT_REGISTRY_PENDING",
        "full_pytest_run": False,
    }
