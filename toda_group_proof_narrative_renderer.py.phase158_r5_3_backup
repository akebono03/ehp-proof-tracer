def _phase136_compact_eta_powers(
  latex: str,
) -> str:
  if not isinstance(
    latex,
    str,
  ):
    raise TypeError(
      "latex must be a str"
    )

  replacements = (
    (
      r"\eta_{2}\eta_{3}\eta_{4}",
      r"\eta_{2}^{3}",
    ),
    (
      r"\eta_{3}\eta_{4}\eta_{5}",
      r"\eta_{3}^{3}",
    ),
    (
      r"\eta_{2}\eta_{3}",
      r"\eta_{2}^{2}",
    ),
    (
      r"\eta_{3}\eta_{4}",
      r"\eta_{3}^{2}",
    ),
  )

  rendered = latex

  for old, new in replacements:
    rendered = rendered.replace(
      old,
      new,
    )

  return rendered


