from types import SimpleNamespace

import pytest

import main as cli_main


def test_phase103_6c5_explore_applicable_default_uses_compact_renderer(
  monkeypatch,
  capsys,
):
  fake_result = SimpleNamespace()

  monkeypatch.setattr(
    cli_main,
    (
      "explore_standard_repository_"
      "generator_applicability_input"
    ),
    lambda generator_input: fake_result,
  )

  monkeypatch.setattr(
    cli_main,
    (
      "render_repository_generator_"
      "applicability_compact_markdown"
    ),
    lambda result: "COMPACT REPORT\n",
  )

  monkeypatch.setattr(
    cli_main,
    (
      "render_repository_generator_"
      "applicability_detailed_markdown"
    ),
    lambda result: "DETAILED REPORT\n",
  )

  exit_code = cli_main.main(
    [
      "explore-applicable",
      "nu_prime",
    ]
  )

  captured = capsys.readouterr()

  assert exit_code == 0
  assert captured.out == "COMPACT REPORT\n"
  assert captured.err == ""


