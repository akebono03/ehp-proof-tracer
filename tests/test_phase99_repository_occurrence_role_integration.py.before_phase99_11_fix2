def test_phase99_11_existing_three_argument_occurrence_constructor_remains_valid():
  data = build_phase99_5_actual_repository()

  entry = data[
    "phase68_entry"
  ]

  occurrence = RepositoryGeneratorOccurrence(
    entry=entry,
    path=(
      "rhs",
      "generator",
      "left",
      "generator",
    ),
    matched_generator=(
      data[
        "phase68"
      ][
        "nu_prime_eta6"
      ].left.generator
    ),
  )

  assert occurrence.entry is entry
  assert occurrence.roles == ()


def test_phase99_11_occurrence_accepts_valid_roles_tuple():
  data = build_phase99_5_actual_repository()

  occurrence = RepositoryGeneratorOccurrence(
    entry=data[
      "phase68_entry"
    ],
    path=(
      "rhs",
      "generator",
      "left",
      "generator",
    ),
    matched_generator=(
      data[
        "phase68"
      ][
        "nu_prime_eta6"
      ].left.generator
    ),
    roles=(
      GeneratorOccurrenceRole.RELATION_RHS,
      GeneratorOccurrenceRole.GROUP_GENERATOR,
      GeneratorOccurrenceRole.COMPOSITION_LEFT,
    ),
  )

  assert occurrence.roles == (
    GeneratorOccurrenceRole.RELATION_RHS,
    GeneratorOccurrenceRole.GROUP_GENERATOR,
    GeneratorOccurrenceRole.COMPOSITION_LEFT,
  )


