def test_phase99_11_actual_repository_occurrences_include_semantic_roles():
  data = build_phase99_5_actual_repository()

  result = (
    find_repository_generator_occurrences(
      data[
        "repository"
      ],
      GeneratorSymbol(
        family="ν",
        decoration="′",
      ),
    )
  )

  assert tuple(
    occurrence.entry
    for occurrence in result
  ) == (
    data[
      "theorem_entry"
    ],
    data[
      "phase67_entry"
    ],
    data[
      "phase68_entry"
    ],
    data[
      "phase70_entry"
    ],
  )

  assert tuple(
    occurrence.roles
    for occurrence in result
  ) == (
    (
      GeneratorOccurrenceRole.TODA_BRACKET_SECOND,
    ),
    (
      GeneratorOccurrenceRole.RELATION_RHS,
      GeneratorOccurrenceRole.GROUP_GENERATOR,
      GeneratorOccurrenceRole.COMPOSITION_RIGHT,
    ),
    (
      GeneratorOccurrenceRole.RELATION_RHS,
      GeneratorOccurrenceRole.GROUP_GENERATOR,
      GeneratorOccurrenceRole.COMPOSITION_LEFT,
    ),
    (
      GeneratorOccurrenceRole.RELATION_RHS,
      GeneratorOccurrenceRole.GROUP_GENERATOR,
      GeneratorOccurrenceRole.COMPOSITION_LEFT,
    ),
  )


def test_phase99_11_actual_repository_occurrences_preserve_paths_and_roles_together():
  data = build_phase99_5_actual_repository()

  result = (
    find_repository_generator_occurrences(
      data[
