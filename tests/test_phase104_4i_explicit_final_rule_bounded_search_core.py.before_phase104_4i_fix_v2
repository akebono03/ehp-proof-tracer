from dataclasses import dataclass

import pytest

from proof import (
  InferenceRule,
)
from proof_repository import (
  ProofRepository,
)
from repository_inference import (
  BoundedProducerSearchStatus,
  _build_bounded_producer_search_report_for_final_rule,
  _diagnose_bounded_producer_search_failure_for_final_rule,
  _select_bounded_producer_chain_for_final_rule,
  build_depth_two_producer_search_report,
  diagnose_depth_two_producer_search_failure,
  select_unique_depth_two_producer_chain,
)
from rule_catalog import (
  InferenceRuleCatalog,
  InferenceRuleCatalogEntry,
)


@dataclass(frozen=True)
class Phase1044IGoal:
  value: str


def _build_ambiguous_final_rule_fixture():
  goal = Phase1044IGoal(
    value="goal",
  )

  first_rule = InferenceRule(
    name="phase104 4i first final rule",
    conclusion_builder=(
      lambda premises:
      Phase1044IGoal(
        value="goal",
      )
    ),
  )

  second_rule = InferenceRule(
    name="phase104 4i second final rule",
    conclusion_builder=(
      lambda premises:
      Phase1044IGoal(
        value="goal",
      )
    ),
  )

  catalog = InferenceRuleCatalog()

  first_entry = InferenceRuleCatalogEntry(
    key="phase104.4i.first",
    rule=first_rule,
    conclusion_type=Phase1044IGoal,
    fixed_point_safe=True,
  )
  second_entry = InferenceRuleCatalogEntry(
    key="phase104.4i.second",
    rule=second_rule,
    conclusion_type=Phase1044IGoal,
    fixed_point_safe=True,
  )

  catalog.register(
    first_entry
  )
  catalog.register(
    second_entry
  )

  return {
    "repository": ProofRepository(),
    "catalog": catalog,
    "goal": goal,
    "first_rule": first_rule,
    "second_rule": second_rule,
    "first_entry": first_entry,
    "second_entry": second_entry,
  }


def test_phase104_4i_legacy_selection_preserves_final_rule_ambiguity():
  data = _build_ambiguous_final_rule_fixture()

  result = (
    select_unique_depth_two_producer_chain(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
    )
  )

  assert result is None


def test_phase104_4i_explicit_selection_uses_requested_final_rule_identity():
  data = _build_ambiguous_final_rule_fixture()

  result = (
    _select_bounded_producer_chain_for_final_rule(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
      data[
        "second_rule"
      ],
    )
  )

  assert result is not None
  assert result.final_rule is data[
    "second_rule"
  ]
  assert (
    result.final_availability.inference_rule
    is data[
      "second_rule"
    ]
  )


def test_phase104_4i_legacy_diagnostic_preserves_ambiguous_final_rule():
  data = _build_ambiguous_final_rule_fixture()

  diagnostic = (
    diagnose_depth_two_producer_search_failure(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
    )
  )

  assert diagnostic is not None
  assert diagnostic.status is (
    BoundedProducerSearchStatus
    .AMBIGUOUS_FINAL_RULE
  )
  assert diagnostic.final_rule is None
  assert diagnostic.final_rule_candidates == (
    data[
      "first_rule"
    ],
    data[
      "second_rule"
    ],
  )


def test_phase104_4i_explicit_diagnostic_does_not_reselect_final_rule():
  data = _build_ambiguous_final_rule_fixture()

  diagnostic = (
    _diagnose_bounded_producer_search_failure_for_final_rule(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
      data[
        "second_rule"
      ],
    )
  )

  assert diagnostic is None


def test_phase104_4i_legacy_report_preserves_ambiguous_final_rule():
  data = _build_ambiguous_final_rule_fixture()

  report = (
    build_depth_two_producer_search_report(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
    )
  )

  assert report.status is (
    BoundedProducerSearchStatus
    .AMBIGUOUS_FINAL_RULE
  )
  assert report.search_result is None
  assert report.diagnostic is not None


def test_phase104_4i_explicit_report_preserves_requested_final_rule_identity():
  data = _build_ambiguous_final_rule_fixture()

  report = (
    _build_bounded_producer_search_report_for_final_rule(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
      data[
        "second_rule"
      ],
    )
  )

  assert report.status is (
    BoundedProducerSearchStatus.SUCCESS
  )
  assert report.diagnostic is None
  assert report.search_result is not None
  assert report.search_result.final_rule is data[
    "second_rule"
  ]


@pytest.mark.parametrize(
  "helper_name",
  (
    "selection",
    "diagnostic",
    "report",
  ),
)
def test_phase104_4i_explicit_cores_reject_non_inference_rule(
  helper_name,
):
  data = _build_ambiguous_final_rule_fixture()

  if helper_name == "selection":
    helper = (
      _select_bounded_producer_chain_for_final_rule
    )
  elif helper_name == "diagnostic":
    helper = (
      _diagnose_bounded_producer_search_failure_for_final_rule
    )
  else:
    helper = (
      _build_bounded_producer_search_report_for_final_rule
    )

  with pytest.raises(
    TypeError,
    match=(
      "final_rule must be an InferenceRule"
    ),
  ):
    helper(
      data[
        "repository"
      ],
      data[
        "catalog"
      ],
      data[
        "goal"
      ],
      object(),
    )
