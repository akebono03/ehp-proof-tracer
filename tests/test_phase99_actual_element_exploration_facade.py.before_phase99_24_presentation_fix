from functools import lru_cache

from proof_repository import (
  ProofRepository,
  ProofRepositoryEntry,
)
from repository_element_facade import (
  explore_repository_generator,
)
from test_phase67_pi6_2_eta2_nu_prime import (
  build_phase67_6_data,
)
from test_phase68_pi7_3_nu_prime_eta6 import (
  build_phase68_3_data,
)


@lru_cache(maxsize=1)
def build_phase99_24_data():
  phase67 = (
    build_phase67_6_data()
  )

  phase68 = (
    build_phase68_3_data()
  )

  nu_prime_generator = (
    phase67[
      "nu_prime"
    ].generator
  )

  assert nu_prime_generator is not None

  repository = ProofRepository()

  phase67_entry = ProofRepositoryEntry(
    key=(
      "phase67."
      "pi6_2_eta2_nu_prime"
    ),
    step=phase67[
      "final_step"
    ],
    phase="67",
    theorem="Toda Lemma 5.7",
  )

  phase68_entry = ProofRepositoryEntry(
    key=(
      "phase68."
      "pi7_3_nu_prime_eta6"
    ),
    step=phase68[
      "final_step"
    ],
    phase="68",
    theorem="Toda Proposition 5.8",
  )

  repository.register(
    phase67_entry
  )

  repository.register(
    phase68_entry
  )

  report = (
    explore_repository_generator(
      repository,
      nu_prime_generator,
    )
  )

  return {
    "phase67": phase67,
    "phase68": phase68,
    "repository": repository,
    "phase67_entry": (
      phase67_entry
    ),
    "phase68_entry": (
      phase68_entry
    ),
    "nu_prime_generator": (
      nu_prime_generator
    ),
    "report": report,
  }


def test_phase99_24_uses_actual_phase67_and_phase68_proof_steps():
  data = build_phase99_24_data()

  assert (
    data[
      "phase67_entry"
    ].step
    is data[
      "phase67"
    ][
      "final_step"
    ]
  )

  assert (
    data[
      "phase68_entry"
    ].step
    is data[
      "phase68"
    ][
      "final_step"
    ]
  )


def test_phase99_24_one_shot_facade_preserves_requested_generator():
  data = build_phase99_24_data()

  assert (
    data[
      "report"
    ].exploration.generator
    == data[
      "nu_prime_generator"
    ]
  )


def test_phase99_24_one_shot_facade_finds_both_actual_occurrences():
  data = build_phase99_24_data()

  occurrences = (
    data[
      "report"
    ].exploration.occurrences
  )

  assert len(
    occurrences
  ) == 2

  assert tuple(
    occurrence.entry.key
    for occurrence in occurrences
  ) == (
    (
      "phase67."
      "pi6_2_eta2_nu_prime"
    ),
    (
      "phase68."
      "pi7_3_nu_prime_eta6"
    ),
  )


def test_phase99_24_actual_occurrences_preserve_matched_generator():
  data = build_phase99_24_data()

  assert all(
    occurrence.matched_generator
    == data[
      "nu_prime_generator"
    ]
    for occurrence in (
      data[
        "report"
      ].exploration.occurrences
    )
  )


