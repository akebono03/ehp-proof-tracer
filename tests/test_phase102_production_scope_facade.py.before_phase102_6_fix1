def test_phase102_6_unknown_generator_is_normal_zero_semantic_result():
  result = (
    explore_standard_repository_generator_proof_scope_input(
      "eta_999"
    )
  )

  assert (
    result.generator
    == GeneratorSymbol(
      family="η",
      index=999,
    )
  )

  assert (
    result.occurrences
    == ()
  )

  assert (
    result.toda_memberships
    == ()
  )

  assert (
    result.map_relations
    == ()
  )


@pytest.mark.parametrize(
  "value",
  (
    "",
    "   ",
    "not_a_generator",
    "nu prime",
    "eta_0",
  ),
)
def test_phase102_6_reuses_existing_invalid_string_input_validation(
  value,
):
  with pytest.raises(
    ValueError,
  ):
    explore_standard_repository_generator_proof_scope_input(
      value
    )


def test_phase102_6_reuses_existing_non_string_validation():
  with pytest.raises(
    TypeError,
    match="value must be a str",
  ):
    explore_standard_repository_generator_proof_scope_input(
      None
    )


def test_phase102_6_repository_facade_rejects_non_repository():
  with pytest.raises(
    TypeError,
    match=(
      "repository must be a ProofRepository"
    ),
  ):
    explore_repository_generator_proof_scope(
      "not-a-repository",
      NU_PRIME_GENERATOR,
    )


def test_phase102_6_repository_facade_rejects_non_generator():
  with pytest.raises(
    TypeError,
    match=(
      "generator must be a GeneratorSymbol"
    ),
  ):
    explore_repository_generator_proof_scope(
      ProofRepository(),
      "ν′",
    )


def test_phase102_6_production_facade_is_deterministic():
  first = (
    explore_standard_repository_generator_proof_scope_input(
      "nu_prime"
    )
  )

  second = (
    explore_standard_repository_generator_proof_scope_input(
      "nu_prime"
    )
  )

  assert (
    _signature(
      first
    )
    == _signature(
      second
    )
  )


def test_phase102_6_repository_is_not_mutated():
  repository = (
    build_standard_production_proof_repository()
  )

  before = (
    repository.entries()
  )

  result = (
    explore_repository_generator_proof_scope(
      repository,
      NU_PRIME_GENERATOR,
    )
  )

  after = (
    repository.entries()
  )

  assert result.occurrences

  assert after == before

  assert all(
    actual is expected
    for actual, expected in zip(
      after,
      before,
    )
  )
