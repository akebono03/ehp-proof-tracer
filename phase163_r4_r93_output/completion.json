      "chapter": 1,
      "line": 387,
      "source_file": "Toda_01_corrected.tex",
      "kind": "equation",
      "locator": "UNLABELED EQUATION CH1 LINE 387",
      "source_text": "\\begin{equation}\n% (1.8)\nd_n:S^n\\times I\\longrightarrow S^{n+1},\\qquad\nd_n\\bigl(\\psi_n(t_1,\\ldots,t_n),t\\bigr)=\\psi_{n+1}(t_1,\\ldots,t_n,t).\n\\end{equation}",
