    {
      "source_id": "toda:tex:ch1:unlabeled-equation:line242",
      "chapter": 1,
      "line": 242,
      "source_file": "Toda_01_corrected.tex",
      "kind": "equation",
      "locator": "UNLABELED EQUATION CH1 LINE 242",
      "source_text": "\\begin{equation}\n% \\tag{1.4}\n\\raisetag{3ex}\n\\begin{aligned}[t]\n\\text{0).}\\ & f\\simeq f':(A,a_0)\\to(A',a'_0),\\quad\n g\\simeq g':(B,b_0)\\to(B',b'_0)\\ \\Rightarrow\\\\\n& f\\wedge g\\simeq f'\\wedge g':\n(A\\wedge B,a_0\\wedge b_0)\\to(A'\\wedge B',a'_0\\wedge b'_0),\n\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\\\\n\\text{i).}\\ & (f\\wedge g)\\wedge h = f\\wedge (g\\wedge h),\\\\\n\\text{ii).}\\ & (f_2\\circ f_1)\\ \\wedge\\ (g_2\\circ g_1)\\ \n= \\ (f_2\\ \\wedge\\ g_2)\\circ(f_1\\ \\wedge\\ g_1).\n\\end{aligned}\n\\end{equation}",
      "source_sha256": "95174efcd88208d3edd2e94d01c94bca7913b3514983fc76962bda435598145f",
      "status": "SOURCE_ONLY_UNLABELED",
      "review_needed": true
    },
    {
      "source_id": "toda:tex:ch1:unlabeled-equation:line270",
      "chapter": 1,
      "line": 270,
      "source_file": "Toda_01_corrected.tex",
      "kind": "equation",
      "locator": "UNLABELED EQUATION CH1 LINE 270",
      "source_text": "\\begin{equation}\n% (1.5)\n\\raisetag{3ex}\n\\begin{aligned}[t]\n  \\text{i).}\\ & (\\alpha\\wedge\\beta)\\wedge\\gamma \n  = \\alpha\\wedge(\\beta\\wedge\\gamma).\\\\\n  \\text{ii).}\\ & (\\alpha'\\circ\\alpha)\\wedge(\\beta'\\circ\\beta)\n  = (\\alpha'\\wedge\\beta')\\circ(\\alpha\\wedge\\beta).\n  \\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\n\\end{aligned}\n\\end{equation}",
      "source_sha256": "49b8a5b93614f432cb216bd4afc791ff693bcc0cf3244a70ecc918ea8fb85504",
      "status": "SOURCE_ONLY_UNLABELED",
      "review_needed": true
    },
    {
      "source_id": "toda:tex:ch1:unlabeled-equation:line304",
      "chapter": 1,
      "line": 304,
      "source_file": "Toda_01_corrected.tex",
      "kind": "equation",
      "locator": "UNLABELED EQUATION CH1 LINE 304",
      "source_text": "\\begin{equation}\n% (1.6)\n\\raisetag{3ex}\n\\begin{aligned}[t]\n  \\text{0).}\\ \n  & f\\simeq g:X\\to Y \\text{ は, }\n  E^n f\\simeq E^n g \\text{ を導く.}\\\\\n  & [f]\\mapsto [E^n f] \\text{ は, } \n  E^n : [X,Y] \\to [E^n X, E^n Y] \\text{ を定める.}\\\\\n  \\text{i).}\\ \n  & E^n(E^m\\alpha) = E^{n+m}\\alpha,\n  \\text{ for } \\alpha\\in [X,Y].\\\\\n  \\text{ii).}\\\n  & E^n(g\\circ f) = E^n g\\circ E^n f,\\quad\n  E^n(\\beta\\circ\\alpha) = E^n\\beta\\circ E^n\\alpha.  \n  \\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\\qquad\n\\end{aligned}  \n\\end{equation}",
      "source_sha256": "4c9c4da77d1cb11e984ab5abc60c73381fe059107de6f7e3bd61d1e9c55cbb31",
      "status": "SOURCE_ONLY_UNLABELED",
      "review_needed": true
    },
    {
