from dataclasses import dataclass
from functools import lru_cache

from homotopy_groups import (
  FiniteCyclicGroup,
  TodaEHPExactnessWindow,
  TodaPrimaryGroup,
  TodaPrimaryGroupZeroStatement,
)
from map_facts import (
  EHP_DELTA_MAP,
  EHP_E_MAP,
  EHP_H_MAP,
)
from proof import (
  ProofRule,
  ProofStep,
  Relation,
  run_inference_until_stable_with_history,
)
from toda_prop56_zero_bootstrap import (
  build_toda_prop56_zero_argument_step,
)
from toda_prop58_zero_bootstrap import (
  build_toda_prop58_zero_argument_step,
)
from toda_prop511_zero_bootstrap import (
  build_toda_prop511_zero_argument_step,
)
from toda_rules import (
  Toda52CompositionIsomorphismStatement,
  Toda55NuFamilyFiniteDimensionalStatement,
  Toda56Nu4DecompositionIsomorphismStatement,
  TodaDeltaImageUpToSignStatement,
  TodaLemma513Statement,
  TodaProp59FiniteDimensionalStatement,
  TodaProp515Pi12_5HopfIsomorphismStatement,
  toda_exactness_zero_left_implies_hopf_injective_inference_rule,
  toda_lemma513_sigma_triple_prime_definition_inference_rule,
  toda_prop511_pi12_9_nu9_inference_rule,
  toda_prop515_pi9_2_zero_inference_rule,
  toda_prop515_pi10_3_concrete_exactness_inference_rule,
  toda_prop515_pi10_3_delta_injective_inference_rule,
  toda_prop515_pi10_3_delta_surjective_inference_rule,
  toda_prop515_pi10_3_zero_inference_rule,
  toda_prop515_pi11_4_zero_inference_rule,
  toda_prop515_pi12_5_concrete_exactness_inference_rule,
  toda_prop515_pi12_5_finite_cyclic_inference_rule,
  toda_prop515_pi12_5_hopf_isomorphism_inference_rule,
)


@dataclass(frozen=True)
class TodaProp515LowBootstrapResult:
  prop56_step: ProofStep
  prop58_step: ProofStep
  prop511_step: ProofStep
  toda52_step: ProofStep
  prop59_step: ProofStep
  toda56_step: ProofStep
  toda55_step: ProofStep
  delta_nu9_step: ProofStep
  pi9_2_zero_step: ProofStep
  pi10_3_zero_step: ProofStep
  pi11_4_zero_step: ProofStep
  pi12_9_step: ProofStep
  hopf_isomorphism_step: ProofStep
  lemma513_step: ProofStep
  pi12_5_step: ProofStep


def _proof_step_closure(
  roots,
):
  ordered_steps = []
  seen_ids = set()

  def visit(
    step,
  ):
    if not isinstance(
      step,
      ProofStep,
    ):
      return

    step_id = id(step)

    if step_id in seen_ids:
      return

    seen_ids.add(
      step_id
    )

    for premise in step.premises:
      visit(
        premise
      )

    ordered_steps.append(
      step
    )

  for root in roots:
    visit(
      root
    )

  return tuple(
    ordered_steps
  )


def _require_unique_inference_step(
  steps,
  statement_type,
  predicate=None,
):
  matches = tuple(
    step
    for step in steps
    if (
      step.rule
      == ProofRule.INFERENCE
      and isinstance(
        step.conclusion,
        statement_type,
      )
      and (
        predicate is None
        or predicate(
          step.conclusion
        )
      )
    )
  )

  if len(matches) != 1:
    raise RuntimeError(
      "expected exactly one derived "
      f"{statement_type.__name__}; "
      f"found {len(matches)}"
    )

  return matches[
    0
  ]


@lru_cache(maxsize=1)
def build_toda_prop515_low_bootstrap():
  prop56_step = (
    build_toda_prop56_zero_argument_step()
  )

  prop58_step = (
    build_toda_prop58_zero_argument_step()
  )

  prop511_step = (
    build_toda_prop511_zero_argument_step()
  )

  upstream_steps = (
    _proof_step_closure(
      (
        prop56_step,
        prop58_step,
        prop511_step,
      )
    )
  )

  toda52_step = (
    _require_unique_inference_step(
      upstream_steps,
      Toda52CompositionIsomorphismStatement,
      lambda statement: (
        statement.source_group
        .sphere_dimension
        == 3
        and statement.target_group
        .sphere_dimension
        == 2
        and statement.source_group
        .group_dimension
        == statement.target_group
        .group_dimension
      ),
    )
  )

  prop59_step = (
    _require_unique_inference_step(
      upstream_steps,
      TodaProp59FiniteDimensionalStatement,
    )
  )

  toda56_step = (
    _require_unique_inference_step(
      upstream_steps,
      Toda56Nu4DecompositionIsomorphismStatement,
    )
  )

  toda55_step = (
    _require_unique_inference_step(
      upstream_steps,
      Toda55NuFamilyFiniteDimensionalStatement,
    )
  )

  delta_nu9_step = (
    _require_unique_inference_step(
      upstream_steps,
      TodaDeltaImageUpToSignStatement,
      lambda statement: (
        statement.map.source_group
        == TodaPrimaryGroup(
          group_dimension=12,
          sphere_dimension=9,
        )
        and statement.map.target_group
        == TodaPrimaryGroup(
          group_dimension=10,
          sphere_dimension=4,
        )
      ),
    )
  )

  pi9_2_result = (
    run_inference_until_stable_with_history(
      (
        toda_prop515_pi9_2_zero_inference_rule(),
      ),
      (
        prop511_step,
        toda52_step,
      ),
    )
  )

  pi9_2_zero = (
    TodaPrimaryGroupZeroStatement(
      group=TodaPrimaryGroup(
        group_dimension=9,
        sphere_dimension=2,
      ),
    )
  )

  pi9_2_zero_step = next(
    step
    for step in pi9_2_result.steps
    if (
      step.conclusion
      == pi9_2_zero
    )
  )

  pi9_2 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=2,
  )

  pi10_3 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=3,
  )

  pi10_5 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=5,
  )

  pi8_2 = TodaPrimaryGroup(
    group_dimension=8,
    sphere_dimension=2,
  )

  pi9_3 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=3,
  )

  pi10_e_h_window_step = ProofStep(
    conclusion=TodaEHPExactnessWindow(
      source_term=pi9_2,
      middle_term=pi10_3,
      target_term=pi10_5,
      first_map=EHP_E_MAP,
      second_map=EHP_H_MAP,
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi10_h_delta_window_step = ProofStep(
    conclusion=TodaEHPExactnessWindow(
      source_term=pi10_3,
      middle_term=pi10_5,
      target_term=pi8_2,
      first_map=EHP_H_MAP,
      second_map=EHP_DELTA_MAP,
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi10_delta_e_window_step = ProofStep(
    conclusion=TodaEHPExactnessWindow(
      source_term=pi10_5,
      middle_term=pi8_2,
      target_term=pi9_3,
      first_map=EHP_DELTA_MAP,
      second_map=EHP_E_MAP,
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi10_result = (
    run_inference_until_stable_with_history(
      (
        toda_prop515_pi10_3_concrete_exactness_inference_rule(),
        toda_exactness_zero_left_implies_hopf_injective_inference_rule(),
        toda_prop515_pi10_3_delta_surjective_inference_rule(),
        toda_prop515_pi10_3_delta_injective_inference_rule(),
        toda_prop515_pi10_3_zero_inference_rule(),
      ),
      (
        pi9_2_zero_step,
        prop59_step,
        prop511_step,
        pi10_e_h_window_step,
        pi10_h_delta_window_step,
        pi10_delta_e_window_step,
      ),
    )
  )

  pi10_3_zero = (
    TodaPrimaryGroupZeroStatement(
      group=pi10_3,
    )
  )

  pi10_3_zero_step = next(
    step
    for step in pi10_result.steps
    if (
      step.conclusion
      == pi10_3_zero
    )
  )

  pi11_result = (
    run_inference_until_stable_with_history(
      (
        toda_prop515_pi11_4_zero_inference_rule(),
      ),
      (
        pi10_3_zero_step,
        prop58_step,
        toda56_step,
      ),
    )
  )

  pi11_4_zero = (
    TodaPrimaryGroupZeroStatement(
      group=TodaPrimaryGroup(
        group_dimension=11,
        sphere_dimension=4,
      ),
    )
  )

  pi11_4_zero_step = next(
    step
    for step in pi11_result.steps
    if (
      step.conclusion
      == pi11_4_zero
    )
  )

  pi12_9_result = (
    run_inference_until_stable_with_history(
      (
        toda_prop511_pi12_9_nu9_inference_rule(),
      ),
      (
        prop56_step,
      ),
    )
  )

  pi12_9 = TodaPrimaryGroup(
    group_dimension=12,
    sphere_dimension=9,
  )

  pi12_9_step = next(
    step
    for step in pi12_9_result.steps
    if (
      isinstance(
        step.conclusion,
        Relation,
      )
      and step.conclusion.lhs
      == pi12_9
    )
  )

  pi12_5 = TodaPrimaryGroup(
    group_dimension=12,
    sphere_dimension=5,
  )

  pi10_4 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=4,
  )

  pi12_e_h_window_step = ProofStep(
    conclusion=TodaEHPExactnessWindow(
      source_term=TodaPrimaryGroup(
        group_dimension=11,
        sphere_dimension=4,
      ),
      middle_term=pi12_5,
      target_term=pi12_9,
      first_map=EHP_E_MAP,
      second_map=EHP_H_MAP,
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi12_h_delta_window_step = ProofStep(
    conclusion=TodaEHPExactnessWindow(
      source_term=pi12_5,
      middle_term=pi12_9,
      target_term=pi10_4,
      first_map=EHP_H_MAP,
      second_map=EHP_DELTA_MAP,
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi12_result = (
    run_inference_until_stable_with_history(
      (
        toda_prop515_pi12_5_concrete_exactness_inference_rule(),
        toda_exactness_zero_left_implies_hopf_injective_inference_rule(),
        toda_prop515_pi12_5_hopf_isomorphism_inference_rule(),
        toda_lemma513_sigma_triple_prime_definition_inference_rule(),
        toda_prop515_pi12_5_finite_cyclic_inference_rule(),
      ),
      (
        pi11_4_zero_step,
        toda55_step,
        delta_nu9_step,
        prop511_step,
        pi12_9_step,
        pi12_e_h_window_step,
        pi12_h_delta_window_step,
      ),
    )
  )

  hopf_isomorphism_step = next(
    step
    for step in pi12_result.steps
    if isinstance(
      step.conclusion,
      TodaProp515Pi12_5HopfIsomorphismStatement,
    )
  )

  lemma513_step = next(
    step
    for step in pi12_result.steps
    if isinstance(
      step.conclusion,
      TodaLemma513Statement,
    )
  )

  pi12_5_step = next(
    step
    for step in pi12_result.steps
    if (
      isinstance(
        step.conclusion,
        Relation,
      )
      and step.conclusion.lhs
      == pi12_5
      and isinstance(
        step.conclusion.rhs,
        FiniteCyclicGroup,
      )
      and step.conclusion.rhs.order
      == 2
      and step.conclusion.rhs.generator
      == (
        lemma513_step
        .conclusion
        .sigma_triple_prime
      )
    )
  )

  return (
    TodaProp515LowBootstrapResult(
      prop56_step=prop56_step,
      prop58_step=prop58_step,
      prop511_step=prop511_step,
      toda52_step=toda52_step,
      prop59_step=prop59_step,
      toda56_step=toda56_step,
      toda55_step=toda55_step,
      delta_nu9_step=delta_nu9_step,
      pi9_2_zero_step=(
        pi9_2_zero_step
      ),
      pi10_3_zero_step=(
        pi10_3_zero_step
      ),
      pi11_4_zero_step=(
        pi11_4_zero_step
      ),
      pi12_9_step=pi12_9_step,
      hopf_isomorphism_step=(
        hopf_isomorphism_step
      ),
      lemma513_step=lemma513_step,
      pi12_5_step=pi12_5_step,
    )
  )
