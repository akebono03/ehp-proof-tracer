      toda_prop53_n4_zero_right_suspension_surjective_inference_rule(),
      toda_prop53_n4_suspension_isomorphism_inference_rule(),
    ),
    (
      _build_phase48_injectivity_step(),
      ProofStep(
        conclusion=pi_6_7_zero_fact(),
        premises=(),
