  toda56_step = _build_toda56_step(
    lemma54_step
  )

  return build_toda_prop56_bootstrap_step(
    core[
      "toda52_step"
    ],
    pi5_3_step,
    core[
      "hopf_nu_prime_step"
    ],
    prop53_step,
    core[
      "double_step"
    ],
    core[
      "membership_step"
    ],
    hopf_surjective_step,
    pi6_5_step,
    toda55_step,
    toda56_step,
    core[
