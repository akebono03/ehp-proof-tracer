        ),
        premises=(),
        rule=ProofRule.GIVEN,
      ),
    ),
  )

  expected = TodaSuspensionIsomorphismStatement(
    map=TodaSuspensionMap(
      source_group=pi_5_3,
      target_group=pi_6_4,
    ),
  )

  return _find_unique_step(
    result.steps,
    lambda step: step.conclusion == expected,
    "E: pi_5^3 -> pi_6^4 isomorphism",
  )


