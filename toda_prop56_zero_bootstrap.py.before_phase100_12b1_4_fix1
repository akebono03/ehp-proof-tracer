  stable_step = build_toda_45_stable_isomorphism_step(
    n=4,
    k=2,
    m=n,
  )

  higher_range_step = ProofStep(
    conclusion=ScalarGreaterEqualStatement(
      left=n,
      right=5,
    ),
    premises=(),
