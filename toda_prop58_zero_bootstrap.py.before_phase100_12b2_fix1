def _find_unique_step(
  steps: tuple[ProofStep, ...],
  predicate,
  description: str,
) -> ProofStep:
  matches = tuple(
    step
    for step in steps
    if predicate(step)
  )

  if len(matches) != 1:
    raise ValueError(
      "expected exactly one "
      f"{description} step, "
      f"found {len(matches)}"
    )

  return matches[0]


def _find_in_provenance(
  root: ProofStep,
  predicate,
  description: str,
) -> ProofStep:
  found = []
  visited = set()
  stack = [root]

  while stack:
    step = stack.pop()

    if id(step) in visited:
      continue

    visited.add(
      id(step)
    )

    if predicate(step):
      found.append(
        step
      )

    stack.extend(
      step.premises
    )

  if len(found) != 1:
    raise ValueError(
      "expected exactly one "
      f"{description} provenance step, "
      f"found {len(found)}"
    )

  return found[0]


def _build_support() -> dict[
  str,
  ProofStep,
]:
  core = (
    build_toda_prop56_upstream_core()
  )

  phase50 = _build_phase50_result()

  pi4_3_step = phase50[
    "final_group_step"
  ]

  pi4_2_step = _build_pi4_2_step(
    pi4_3_step,
    core[
      "toda52_step"
    ],
  )

  prop51_step = _build_prop51_step()

  n3_isomorphism_step = (
    _build_n3_suspension_isomorphism_step(
      prop51_step,
      core[
        "hopf_nu_prime_step"
      ],
    )
  )

  pi5_3_step = (
    build_phase59_pi5_3_step(
      pi4_2_step,
      n3_isomorphism_step,
    )
  )

  pi6_4_step = _build_pi6_4_step(
    pi5_3_step
  )

  (
    higher_transport_step,
    higher_range_step,
  ) = _build_higher_eta_transport(
    pi6_4_step
  )

  prop53_step = (
    build_phase59_prop53_step(
      pi4_2_step,
      pi5_3_step,
      pi6_4_step,
      higher_transport_step,
      higher_range_step,
    )
  )

  lemma54_step, pi6_5_step = (
    _build_lemma54_step(
      prop51_step,
      prop53_step,
      core[
        "hopf_nu_prime_step"
      ],
      core[
        "double_step"
      ],
      pi4_3_step,
    )
  )

  n = ScalarSymbol(
    name="n",
  )
  t = ScalarSymbol(
    name="t",
  )

  phase60_3_result = (
    run_inference_until_stable_with_history(
      (
        toda_54_t_ge_1_indeterminacy_eta_cube_inference_rule(),
        toda_54_nu_prime_triple_eta_transport_inference_rule(),
        toda_54_indeterminacy_double_nu_prime_generator_inference_rule(),
      ),
      (
        prop53_step,
        core[
          "double_step"
        ],
        ProofStep(
          conclusion=ScalarGreaterEqualStatement(
            left=n,
            right=3,
          ),
          premises=(),
          rule=ProofRule.GIVEN,
        ),
        ProofStep(
          conclusion=ScalarGreaterEqualStatement(
            left=t,
            right=1,
          ),
          premises=(),
          rule=ProofRule.GIVEN,
        ),
      ),
    )
  )

  triple_eta_step = _find_unique_step(
    phase60_3_result.steps,
    lambda step: (
      isinstance(
        step.conclusion,
        Relation,
      )
      and isinstance(
        step.conclusion.lhs,
        Multiple,
      )
      and step.conclusion.lhs.coefficient
      == 2
      and isinstance(
        step.conclusion.lhs.expression,
        IteratedSuspension,
      )
    ),
    "triple eta transport",
  )

  toda55_step = _build_toda55_step(
    lemma54_step,
    triple_eta_step,
  )

  toda56_step = _build_toda56_step(
    lemma54_step
  )

  return {
    "prop56_step": (
      build_toda_prop56_zero_argument_step()
    ),
    "toda52_step": (
      core[
        "toda52_step"
      ]
    ),
    "hopf_nu_prime_step": (
      core[
        "hopf_nu_prime_step"
      ]
    ),
    "double_nu_prime_step": (
      core[
        "double_step"
      ]
    ),
    "prop51_step": prop51_step,
    "prop53_step": prop53_step,
    "lemma54_step": lemma54_step,
    "toda55_step": toda55_step,
    "toda56_step": toda56_step,
    "pi6_5_step": pi6_5_step,
    "pi4_3_step": pi4_3_step,
  }


def _build_equation57_steps(
  support: dict[
    str,
    ProofStep,
  ],
) -> tuple[
  ProofStep,
  ProofStep,
]:
  eta5_definition_step = ProofStep(
    conclusion=toda_eta_family_definition_statement(
      5
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  eta6_definition_step = ProofStep(
    conclusion=toda_eta_family_definition_statement(
      6
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  pi_7_3 = TodaPrimaryGroup(
    group_dimension=7,
    sphere_dimension=3,
  )
  pi_7_5 = TodaPrimaryGroup(
    group_dimension=7,
    sphere_dimension=5,
  )
  pi_5_2 = TodaPrimaryGroup(
    group_dimension=5,
    sphere_dimension=2,
  )
  pi_6_3 = TodaPrimaryGroup(
    group_dimension=6,
    sphere_dimension=3,
  )

  result = run_inference_until_stable_with_history(
    (
      toda_57_nu_prime_eta6_hopf_inference_rule(),
      toda_prop56_pi7_3_hopf_surjective_inference_rule(),
      toda_prop56_pi7_5_delta_zero_inference_rule(),
      toda_prop56_pi5_2_suspension_injective_inference_rule(),
    ),
    (
      support[
        "hopf_nu_prime_step"
      ],
      support[
        "prop53_step"
      ],
      eta5_definition_step,
      eta6_definition_step,
      ProofStep(
        conclusion=TodaProp42ExactnessStatement(
          window=TodaEHPExactnessWindow(
            source_term=pi_7_3,
            middle_term=pi_7_5,
            target_term=pi_5_2,
            first_map=EHP_H_MAP,
            second_map=EHP_DELTA_MAP,
          ),
        ),
        premises=(),
        rule=ProofRule.GIVEN,
      ),
      ProofStep(
        conclusion=TodaProp42ExactnessStatement(
          window=TodaEHPExactnessWindow(
            source_term=pi_7_5,
            middle_term=pi_5_2,
            target_term=pi_6_3,
            first_map=EHP_DELTA_MAP,
            second_map=EHP_E_MAP,
          ),
        ),
        premises=(),
        rule=ProofRule.GIVEN,
      ),
    ),
  )

  equation57_step = _find_unique_step(
    result.steps,
    lambda step: (
      isinstance(
        step.conclusion,
        Relation,
      )
      and isinstance(
        step.conclusion.lhs,
        MapApplication,
      )
      and step.conclusion.lhs.map
      == EHP_H_MAP
      and isinstance(
        step.conclusion.lhs.expression,
        Composition,
      )
    ),
    "Equation (5.7)",
  )

  hopf_surjective_step = (
    _find_unique_step(
      result.steps,
      lambda step: (
        isinstance(
          step.conclusion,
          TodaHopfInvariantSurjectiveStatement,
        )
        and step.conclusion.map.source_group
        == pi_7_3
      ),
      "pi_7^3 Hopf surjective",
    )
  )

  return (
    equation57_step,
    hopf_surjective_step,
  )


def _build_eta2_nu_prime_zero_step(
  support: dict[
    str,
    ProofStep,
  ],
) -> ProofStep:
  nu5_definition_step = ProofStep(
    conclusion=toda_nu_family_definition_statement(
      5
    ),
    premises=(),
    rule=ProofRule.GIVEN,
  )

  nu_prime = HomotopyElement(
    name="ν′",
    dimension=3,
    source=6,
    target=3,
    generator=GeneratorSymbol(
      family="ν",
      decoration="′",
    ),
  )
  eta_2 = HomotopyElement(
    name="η₂",
    dimension=2,
    source=3,
    target=2,
    generator=GeneratorSymbol(
      family="η",
      index=2,
    ),
  )

  result = run_inference_until_stable_with_history(
    (
      toda_lemma57_nu_prime_hypothesis_inference_rule(),
      toda_prop51_eta4_twice_zero_inference_rule(),
      toda_lemma57_e2_eta2_alpha_composition_inference_rule(),
      toda_lemma57_e2_eta2_alpha_zero_inference_rule(),
      toda_lemma45_n3_suspension_zero_reflection_inference_rule(),
    ),
    (
      support[
        "prop51_step"
      ],
      support[
        "lemma54_step"
      ],
      nu5_definition_step,
    ),
  )

  expected = Relation(
    lhs=Suspension(
      expression=Composition(
        left=eta_2,
        right=nu_prime,
      ),
    ),
    rhs=Zero(),
    relation_type=RelationType.ZERO,
  )

  return _find_unique_step(
    result.steps,
    lambda step: (
      step.conclusion
      == expected
    ),
    "E(eta_2 nu-prime)=0",
  )


def _build_pi6_2_step(
  support: dict[
    str,
    ProofStep,
  ],
) -> ProofStep:
  prop56_step = support[
    "prop56_step"
  ]
  toda52_step = support[
    "toda52_step"
  ]

  nu_prime = (
    prop56_step
    .conclusion
    .pi6_3_group_relation
    .rhs
    .generator
  )
  eta_2 = (
    toda52_step
    .conclusion
    .composition
    .left
  )

  expected = Relation(
    lhs=TodaPrimaryGroup(
      group_dimension=6,
      sphere_dimension=2,
    ),
    rhs=FiniteCyclicGroup(
      order=4,
      generator=Composition(
        left=eta_2,
        right=nu_prime,
      ),
    ),
    relation_type=RelationType.EQUALITY,
  )

  result = run_inference_until_stable_with_history(
    toda_lemma57_pi6_2_eta2_nu_prime_inference_rule(),
    (
      prop56_step,
      toda52_step,
    ),
  )

  return _find_unique_step(
    result.steps,
    lambda step: (
      step.conclusion
      == expected
    ),
    "pi_6^2",
  )


def _build_pi7_3_steps(
  support: dict[
    str,
    ProofStep,
  ],
  equation57_step: ProofStep,
  hopf_surjective_step: ProofStep,
  eta2_nu_prime_zero_step: ProofStep,
  pi6_2_step: ProofStep,
) -> tuple[
  ProofStep,
  ProofStep,
]:
  pi6_2 = TodaPrimaryGroup(
    group_dimension=6,
    sphere_dimension=2,
  )
  pi7_3 = TodaPrimaryGroup(
    group_dimension=7,
    sphere_dimension=3,
  )
  pi7_5 = TodaPrimaryGroup(
    group_dimension=7,
    sphere_dimension=5,
  )

  window = TodaEHPExactnessWindow(
    source_term=pi6_2,
    middle_term=pi7_3,
    target_term=pi7_5,
    first_map=EHP_E_MAP,
    second_map=EHP_H_MAP,
  )

  result = run_inference_until_stable_with_history(
    (
      toda_prop58_concrete_e_h_exactness_inference_rule(),
      toda_prop58_pi7_3_hopf_injective_inference_rule(),
      toda_hopf_injective_surjective_implies_isomorphism_inference_rule(),
      toda_prop58_pi7_3_finite_cyclic_inference_rule(),
    ),
    (
      equation57_step,
      hopf_surjective_step,
      support[
        "prop53_step"
      ],
      eta2_nu_prime_zero_step,
      pi6_2_step,
      ProofStep(
        conclusion=window,
        premises=(),
        rule=ProofRule.GIVEN,
      ),
    ),
  )

  hopf_map = TodaHopfInvariantMap(
    source_group=pi7_3,
    target_group=pi7_5,
  )

  hopf_isomorphism_step = (
    _find_unique_step(
      result.steps,
      lambda step: (
        isinstance(
          step.conclusion,
          TodaHopfInvariantIsomorphismStatement,
        )
        and step.conclusion.map
        == hopf_map
      ),
      "pi_7^3 Hopf isomorphism",
    )
  )

  final_step = _find_unique_step(
    result.steps,
    lambda step: (
      isinstance(
        step.conclusion,
        Relation,
      )
      and step.conclusion.lhs
      == pi7_3
      and isinstance(
        step.conclusion.rhs,
        FiniteCyclicGroup,
      )
      and step.conclusion.rhs.order
      == 2
    ),
    "pi_7^3",
  )

  return (
    final_step,
    hopf_isomorphism_step,
  )


