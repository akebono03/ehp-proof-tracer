def _build_toda59_step(
  support: dict[
    str,
    ProofStep,
  ],
  equation57_step: ProofStep,
  hopf_isomorphism_step: ProofStep,
) -> ProofStep:
  result = run_inference_until_stable_with_history(
    (
      toda_prop58_eta3_nu4_hopf_inference_rule(),
      toda_59_eta3_nu4_inference_rule(),
    ),
    (
      support[
        "lemma54_step"
      ],
      equation57_step,
      hopf_isomorphism_step,
    ),
  )

  eta_3 = HomotopyElement(
    name="η₃",
    dimension=3,
    source=4,
    target=3,
    generator=GeneratorSymbol(
      family="η",
      index=3,
    ),
  )
  nu_4 = HomotopyElement(
    name="ν₄",
    dimension=4,
    source=7,
    target=4,
    generator=GeneratorSymbol(
      family="ν",
      index=4,
    ),
  )
  nu_prime = HomotopyElement(
    name="ν′",
    dimension=3,
    source=6,
    target=3,
    generator=GeneratorSymbol(
      family="ν",
      decoration="′",
    ),
  )
  eta_6 = HomotopyElement(
    name="η₆",
    dimension=6,
    source=7,
    target=6,
    generator=GeneratorSymbol(
      family="η",
      index=6,
    ),
  )

  expected = Relation(
    lhs=Composition(
      left=eta_3,
      right=nu_4,
    ),
    rhs=Composition(
      left=nu_prime,
      right=eta_6,
    ),
    relation_type=RelationType.EQUALITY,
  )

  return _find_unique_step(
    result.steps,
    lambda step: (
      step.conclusion
      == expected
    ),
    "Toda (5.9)",
  )


