def _build_phase66_step(
  support: dict[
    str,
    ProofStep,
  ],
) -> ProofStep:
  prop56_step = support[
    "prop56_step"
  ]

  pi7_4_step = _find_unique_step(
    prop56_step.premises,
    lambda step: (
      step.conclusion
      == (
        prop56_step
        .conclusion
        .pi7_4_group_relation
      )
    ),
    "pi_7^4 branch",
  )

  delta_nu_result = (
    run_inference_until_stable_with_history(
      toda_58_delta_iota9_nu4_nu_prime_inference_rule(),
      (
        pi7_4_step,
      ),
    )
  )

  delta_nu_step = _find_unique_step(
    delta_nu_result.steps,
    lambda step: isinstance(
      step.conclusion,
      TodaDeltaImageUpToSignStatement,
    ),
    "Delta(iota_9) nu expression",
  )

  whitehead_data_step = _find_in_provenance(
    support[
      "lemma54_step"
    ],
    lambda step: isinstance(
      step.conclusion,
      TodaLemma54WhiteheadCorrectionDataStatement,
    ),
    "Lemma 5.4 Whitehead correction data",
  )

  whitehead_result = (
    run_inference_until_stable_with_history(
      toda_58_whitehead_square_nu_expression_inference_rule(),
      (
        delta_nu_step,
        whitehead_data_step,
      ),
    )
  )

  whitehead_step = _find_unique_step(
    whitehead_result.steps,
    lambda step: isinstance(
      step.conclusion,
      Toda58WhiteheadSquareUpToSignStatement,
    ),
    "Whitehead square nu expression",
  )

  delta_whitehead_result = (
    run_inference_until_stable_with_history(
      toda_58_delta_iota9_whitehead_square_inference_rule(),
      (
        delta_nu_step,
        whitehead_step,
      ),
    )
  )

  delta_whitehead_step = (
    _find_unique_step(
      delta_whitehead_result.steps,
      lambda step: (
        isinstance(
          step.conclusion,
          TodaDeltaImageUpToSignStatement,
        )
        and isinstance(
          step.conclusion.positive_value,
          WhiteheadProduct,
        )
      ),
      "Delta(iota_9) Whitehead square",
    )
  )

  expected = Toda58EquationStatement(
    delta_nu_relation=(
      delta_nu_step.conclusion
    ),
    whitehead_nu_relation=(
      whitehead_step.conclusion
    ),
    delta_whitehead_relation=(
      delta_whitehead_step.conclusion
    ),
    literature_statements=(
      toda_58_literature_statements()
    ),
  )

  result = run_inference_until_stable_with_history(
    toda_58_integration_inference_rule(),
    (
      delta_nu_step,
      whitehead_step,
      delta_whitehead_step,
    ),
  )

  return _find_unique_step(
    result.steps,
    lambda step: (
      step.conclusion
      == expected
    ),
    "Equation (5.8)",
  )


