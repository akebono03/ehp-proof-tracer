      "statement_id": "TODA-S000007",
      "chapter": 1,
      "section": "Chapter I",
      "order_key": "7",
      "kind": "Proposition",
      "locator": "Proposition 1.7",
      "tex_label": "prop:1-7",
      "source_line": 1129,
      "source_statement_tex": "\\(\\alpha\\in[E^nY, Z],\\ \\beta\\in[X,Y],\\ \\gamma\\in[W,X]\\) に対して,\n  $\\alpha\\circ \\Ex^n\\beta=\\beta\\circ\\gamma=0$ を仮定する. \\\\\n$\\alpha$ の extension $\\overline\\alpha\\in[\\Ex^n(Y\\cup_\\beta CX), Z]$ と,\n$\\gamma$ の coextension $\\widetilde\\gamma\\in[EW, Y\\cup_\\beta CX]$ を考える. \nこのとき,\n\\[\n\\{\\ \\overline\\alpha\\circ \\Ex^n\\widetilde\\gamma\\ \\}\n= (-1)^n\\{\\alpha,\\ \\Ex^n\\beta,\\ \\Ex^n\\gamma\\}_n.\n\\]",
      "statement_type": "extension_coextension",
      "summary_en": "Extension–coextension composite represents a signed secondary composition.",
      "hypotheses_en": "Two zero composites and extension/coextension choices.",
      "internal_clause_markers": [],
      "source_status": "unchecked",
      "transcription_review": "reviewed_against_supplied_tex",
      "search_status": "unconnected",
