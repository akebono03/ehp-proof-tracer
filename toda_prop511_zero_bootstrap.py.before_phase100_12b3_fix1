def _build_phase68_generator_bridge(
  context: dict[
    str,
    ProofStep,
  ],
) -> ProofStep:
  pi8_4_step = context[
    "pi8_4_step"
  ]

  nu5_definition_step = _given(
    toda_nu_family_definition_statement(
      5
    )
  )

  rule = (
    toda_prop58_e_nu4_eta7_bridge_inference_rule()
  )

  match = find_inference_match(
    rule,
    (
      pi8_4_step,
      nu5_definition_step,
    ),
  )

  if match is not None:
    return apply_inference_match(
      match
    )

  pi10_9 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=9,
  )
  pi8_4 = TodaPrimaryGroup(
    group_dimension=8,
    sphere_dimension=4,
  )
  pi9_5 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=5,
  )
  pi9_9 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=9,
  )
  pi7_4 = TodaPrimaryGroup(
    group_dimension=7,
    sphere_dimension=4,
  )

  from toda_rules import (
    toda_prop58_pi9_5_concrete_exactness_inference_rule,
    toda_prop58_pi9_5_finite_cyclic_inference_rule,
    toda_prop58_pi9_5_hopf_zero_inference_rule,
    toda_prop58_pi9_5_suspension_surjective_inference_rule,
    toda_prop58_pi9_9_delta_injective_inference_rule,
  )
  from proof import (
    run_inference_until_stable_with_history,
  )

  result = run_inference_until_stable_with_history(
    (
      toda_prop58_pi9_5_concrete_exactness_inference_rule(),
      toda_prop58_pi9_9_delta_injective_inference_rule(),
      toda_prop58_pi9_5_hopf_zero_inference_rule(),
      toda_prop58_pi9_5_suspension_surjective_inference_rule(),
      toda_prop58_e_nu4_eta7_bridge_inference_rule(),
      toda_prop58_pi9_5_finite_cyclic_inference_rule(),
    ),
    (
      context[
        "prop56_step"
      ],
      context[
        "phase66_step"
      ],
      pi8_4_step,
      context[
        "prop51_step"
      ],
      context[
        "delta_eta9_step"
      ],
      nu5_definition_step,
      _given(
        TodaEHPExactnessWindow(
          source_term=pi10_9,
          middle_term=pi8_4,
          target_term=pi9_5,
          first_map=EHP_DELTA_MAP,
          second_map=EHP_E_MAP,
        )
      ),
      _given(
        TodaEHPExactnessWindow(
          source_term=pi8_4,
          middle_term=pi9_5,
          target_term=pi9_9,
          first_map=EHP_E_MAP,
          second_map=EHP_H_MAP,
        )
      ),
      _given(
        TodaEHPExactnessWindow(
          source_term=pi9_5,
          middle_term=pi9_9,
          target_term=pi7_4,
          first_map=EHP_H_MAP,
          second_map=EHP_DELTA_MAP,
        )
      ),
    ),
  )

  nu4_eta7 = (
    pi8_4_step
    .conclusion
    .rhs
    .summands[0]
    .generator
  )

  return next(
    step
    for step in result.steps
    if (
      isinstance(
        step.conclusion,
        Relation,
      )
      and step.conclusion.lhs
      == Suspension(
        expression=nu4_eta7,
      )
    )
  )


def _build_pi10_6_zero_step(
  context: dict[
    str,
    ProofStep,
  ],
) -> ProofStep:
  from proof import (
    run_inference_until_stable_with_history,
  )

  pi9_5 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=5,
  )
  pi10_6 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=6,
  )
  pi10_11 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=11,
  )

  result = run_inference_until_stable_with_history(
    (
      toda_prop58_pi10_6_concrete_exactness_inference_rule(),
      toda_prop58_pi10_6_suspension_surjective_inference_rule(),
      toda_prop58_pi10_6_zero_inference_rule(),
    ),
    (
      context[
        "pi9_5_step"
      ],
      context[
        "nu6_eta9_zero_step"
      ],
      _given(
        TodaEHPExactnessWindow(
          source_term=pi9_5,
          middle_term=pi10_6,
          target_term=pi10_11,
          first_map=EHP_E_MAP,
          second_map=EHP_H_MAP,
        )
      ),
      _given(
        TodaPrimaryGroupZeroStatement(
          group=pi10_11,
        )
      ),
    ),
  )

  expected = TodaPrimaryGroupZeroStatement(
    group=pi10_6,
  )

  return next(
    step
    for step in result.steps
    if step.conclusion
    == expected
  )


def _build_delta_iota11_context(
  context: dict[
    str,
    ProofStep,
  ],
) -> dict[
  str,
  ProofStep,
]:
  from proof import (
    run_inference_until_stable_with_history,
  )

  pi10_6_zero_step = (
    _build_pi10_6_zero_step(
      context
    )
  )

  pi11_11 = TodaPrimaryGroup(
    group_dimension=11,
    sphere_dimension=11,
  )
  pi9_5 = TodaPrimaryGroup(
    group_dimension=9,
    sphere_dimension=5,
  )
  pi10_6 = TodaPrimaryGroup(
    group_dimension=10,
    sphere_dimension=6,
  )

  delta_result = (
    run_inference_until_stable_with_history(
      (
        toda_eq510_concrete_delta_e_exactness_inference_rule(),
        toda_eq510_delta_surjective_inference_rule(),
      ),
      (
        pi10_6_zero_step,
        _given(
          TodaEHPExactnessWindow(
            source_term=pi11_11,
            middle_term=pi9_5,
            target_term=pi10_6,
            first_map=EHP_DELTA_MAP,
            second_map=EHP_E_MAP,
          )
        ),
      ),
    )
  )

  delta_surjective_step = next(
    step
    for step in delta_result.steps
    if isinstance(
      step.conclusion,
      TodaDeltaSurjectiveStatement,
    )
  )

  iota_11 = HomotopyElement(
    name="ι_11",
    dimension=11,
    generator=GeneratorSymbol(
      family="ι",
      index=11,
    ),
  )

  pi11_11_step = _given(
    Relation(
      lhs=pi11_11,
      rhs=FreeCyclicGroup(
        generator=iota_11,
      ),
      relation_type=RelationType.EQUALITY,
    )
  )

  delta_iota11_step = _apply(
    toda_eq510_delta_iota11_inference_rule(),
    (
      delta_surjective_step,
      pi11_11_step,
      context[
        "pi9_5_step"
      ],
    ),
    "Delta(iota_11)",
  )

  return {
    "pi10_6_zero_step": (
      pi10_6_zero_step
    ),
    "pi11_11_step": (
      pi11_11_step
    ),
    "delta_surjective_step": (
      delta_surjective_step
    ),
    "delta_iota11_step": (
      delta_iota11_step
    ),
  }


