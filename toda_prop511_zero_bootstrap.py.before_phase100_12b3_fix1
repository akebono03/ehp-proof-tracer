def _apply(
  rule,
  premises: tuple[ProofStep, ...],
  description: str,
) -> ProofStep:
  match = find_inference_match(
    rule,
    premises,
  )

  if match is None:
    raise ValueError(
      f"expected {description} inference match"
    )

  return apply_inference_match(
    match
  )


def _find_unique_step(
  root: ProofStep,
  predicate,
  description: str,
) -> ProofStep:
  found = []
  visited = set()
  stack = [root]

  while stack:
    step = stack.pop()

    if id(step) in visited:
      continue

    visited.add(
      id(step)
    )

    if predicate(step):
      found.append(
        step
      )

    stack.extend(
      step.premises
    )

  if len(found) != 1:
    raise ValueError(
      "expected exactly one "
      f"{description} provenance step, "
      f"found {len(found)}"
    )

  return found[0]


def _given(
  conclusion,
) -> ProofStep:
  return ProofStep(
    conclusion=conclusion,
    premises=(),
    rule=ProofRule.GIVEN,
  )


