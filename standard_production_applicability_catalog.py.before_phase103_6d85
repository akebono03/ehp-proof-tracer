def _phase103_6d15_type_names(
  value,
):
  if value is None:
    return ()

  values = (
    value
    if isinstance(value, tuple)
    else (value,)
  )

  result = []
  for item in values:
    if item is None:
      continue
    if isinstance(item, type):
      result.append(
        item.__name__
      )
    else:
      result.append(
        type(item).__name__
      )

  return tuple(
    result
  )


def _phase103_6d15_premise_signature(
  rule,
):
  names = []

  for pattern in getattr(
    rule,
    "premise_patterns",
    (),
  ):
    statement_type = getattr(
      pattern,
      "statement_type",
      None,
    )

    if statement_type is not None:
      names.extend(
        _phase103_6d15_type_names(
          statement_type
        )
      )
      continue

    statement_pattern = getattr(
      pattern,
      "statement_pattern",
      None,
    )

    if statement_pattern is not None:
      names.extend(
        _phase103_6d15_type_names(
          statement_pattern
        )
      )

  return tuple(
    names
  )


